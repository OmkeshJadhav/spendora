# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase — project URL and anon key (Project Settings → API).
# The anon key is public by design; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email provider (Resend). Server-side only — never expose to the browser.
EMAIL_API_KEY=
EMAIL_FROM=

# Supabase service role key — server-only, and currently used only by
# `npm run db:verify-rls` to create and delete throwaway test accounts.
# Never import this into application code and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
