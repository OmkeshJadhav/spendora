# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase — project URL and anon key (Project Settings → API).
# The anon key is public by design; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email provider (Resend). Server-side only — never expose to the browser.
# Optional. Invitations are answered inside the application, so mail is only
# how an invitation reaches somebody who does not have an account yet. Leave
# both blank and invitations still work; the app shows the admin the one-time
# link to pass on instead of mailing it.
# EMAIL_FROM accepts "you@example.com" or "Spendora <you@example.com>", and the
# address must be on a domain verified with the provider.
EMAIL_API_KEY=
EMAIL_FROM=

# Canonical origin for links that leave the application (invitation emails,
# sign-up confirmation). Optional: without it the request's own origin is used,
# which is right in development. Set it in production so a spoofed Host header
# cannot rewrite the link inside an email.
APP_ORIGIN=

# Supabase service role key — server-only, and never read by application code.
# `npm run db:verify-rls`, `npm run verify:expenses` and `npm run verify:groups`
# use it to create and delete their throwaway test accounts.
# Never import this into application code and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (Project Settings → Database). Used only to apply
# migrations with psql; not read by the application.
SUPABASE_DB_URL=
