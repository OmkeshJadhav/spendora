# Copy to .env.local and fill in real values. Never commit .env.local.

# ---------------------------------------------------------------------------
# Required — the application will not run without these.
# ---------------------------------------------------------------------------

# Supabase — project URL and anon key (Project Settings → API).
# The anon key is public by design; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Optional — the application runs without these, with a stated consequence.
# ---------------------------------------------------------------------------

# Email provider (Resend). Server-side only — never expose to the browser.
# Invitations are answered inside the application, so mail is only how an
# invitation reaches somebody who does not have an account yet. Leave both
# blank and invitations still work; the app shows the admin the one-time link
# to pass on instead of mailing it.
# EMAIL_FROM accepts "you@example.com" or "Spendora <you@example.com>", and the
# address must be on a domain verified with the provider.
# Note: this key has no bearing on sign-up confirmation mail, which Supabase
# sends through the SMTP configured on the project. See supabase/README.md.
EMAIL_API_KEY=
EMAIL_FROM=

# Canonical origin for links that leave the application (invitation emails,
# sign-up confirmation). Without it the request's own origin is used, which is
# right in development. Set it in production so a spoofed Host header cannot
# rewrite the link inside an email.
APP_ORIGIN=

# ---------------------------------------------------------------------------
# Test-only — never read by application code, and not needed to run the app.
# ---------------------------------------------------------------------------

# Supabase service role key — server-only. `npm test` and each `verify:*`
# suite use it to create and delete their throwaway test accounts, and nothing
# else; the code under test never sees it.
# Never import this into application code and never expose it to the browser.
# The suites write and delete real rows, so point them at a test project rather
# than one holding real people's expenses.
SUPABASE_SERVICE_ROLE_KEY=

# Where the suites should find the running application. Defaults to
# http://localhost:3000, which is what `npm run dev` serves.
# BASE_URL=

# Postgres connection string (Project Settings → Database). Used only to apply
# migrations with psql; not read by the application or the suites.
# Percent-encode the password if it contains any of @ : / ? # [ ] — libpq
# splits the URL at the *first* @, so an unencoded one in the password makes
# psql read part of it as the hostname and fail to resolve it. @ is %40.
SUPABASE_DB_URL=
